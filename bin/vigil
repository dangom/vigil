#!/usr/bin/env bash
# vigil — what an agent did, kept on this machine for Emacs to show.
#
# Claude Code reports each prompt, tool call and reply to its hooks.  `vigil
# hook' is such a hook: it writes the report, as Claude Code wrote it, to files
# under $VIGIL_DATA_DIR, and does nothing else.  emacs/vigil.el reads them.
#
# Nothing here opens a connection: no report, and nothing about a session,
# leaves this machine.  What is kept is readable by its owner only.
#
#   vigil setup                   put everything below in place at once
#   vigil doctor                  say what is in place, and what is not
#   vigil hook                    a hook's event on standard input -> the records
#   vigil install-hooks           put the hook in Claude Code's settings
#   vigil uninstall-hooks         take it out again
#   vigil install-hooks --agent pi      give pi the extension that reports to
#                                       the hook (pi/vigil.ts)
#   vigil uninstall-hooks --agent pi    and take it away again
#   vigil install-shell           have Claude Code run its shell commands where
#                                 Emacs can follow them (bin/vigil-shell)
#   vigil uninstall-shell         and no longer
#   vigil check-shell             ask Claude Code to run one command, and say
#                                 whether vigil-shell knew it for one
#   vigil coverage on|off|status  have the Python and Node programs an agent's
#                                 commands run note which functions they ran
#   vigil snapshots on|off|status|forget
#                                 keep, in each repository's own .git, what its
#                                 files were when each prompt was given, when
#                                 the agent stopped, and before and after
#                                 each command that changed them
#   vigil snapshot                the hook that keeps one; --now [DIR] keeps one
#                                 of DIR's repository and prints its commit
#
# Two places, for two purposes:
#
# - $VIGIL_RECORDS_DIR/<session>/<time>-<pid>-<n>.json, one file per event, for
#   Emacs to show beside the agent's terminal.  Only for an agent in a hosted
#   session of cooked's, which is told its session's name in
#   COOKED_HOST_SESSION (VIGIL_SESSION overrides it); only the newest
#   VIGIL_RECORDS_MAX per session.  Written to a temporary name and renamed
#   into place, so a reader never sees half of one.
# - The archive: every event, kept for good, to study later.
#
# A record over its size limit keeps its shape: the biggest parts of the event
# are replaced by a marker saying how big they were.
#
# A report is data.  Nothing ever sources or evaluates one.

set -u
umask 077

: "${VIGIL_DATA_DIR:=${XDG_DATA_HOME:-$HOME/.local/share}/vigil}"
: "${VIGIL_RECORDS_DIR:=$VIGIL_DATA_DIR/records}"
: "${VIGIL_RECORD_MAX:=4194304}"
: "${VIGIL_RECORDS_MAX:=2000}"
# Days after its last report that a session's records are removed.
: "${VIGIL_KEEP_DAYS:=14}"
# Every prompt given to an agent here, for searching.
: "${VIGIL_PROMPT_HISTORY:=$VIGIL_DATA_DIR/prompts.jsonl}"
: "${VIGIL_PROMPT_HISTORY_MAX:=5000}"
# The version, as CHANGELOG.md and emacs/vigil.el say it.
VIGIL_VERSION=0.5.2
# Every event, kept for good.  VIGIL_ARCHIVE=0 turns it off; VIGIL_ARCHIVE_ALL=1
# also keeps sessions that are not in a hosted session.
: "${VIGIL_ARCHIVE_DIR:=$VIGIL_DATA_DIR/archive}"
: "${VIGIL_ARCHIVE_RECORD_MAX:=1048576}"
: "${VIGIL_SETTINGS:=$HOME/.claude/settings.json}"
# Where the programs an agent's commands run write which functions they ran.
: "${VIGIL_COVERAGE_DIR:=$VIGIL_DATA_DIR/coverage}"
# Snapshots: the ref they are kept under, one per working tree, and the size
# over which a file git does not track is left out of them.
: "${VIGIL_SNAPSHOT_REF:=refs/worktree/vigil/snapshots}"
: "${VIGIL_SNAPSHOT_MAX:=1048576}"

vigil_usage() {
  cat << 'EOF'
usage: vigil setup [--shell] [--settings FILE] [--dry-run]
       vigil doctor [--settings FILE]
       vigil hook                              (a hook's event on standard input)
       vigil install-hooks [--settings FILE] [--dry-run]
       vigil uninstall-hooks [--settings FILE] [--dry-run]
       vigil install-hooks --agent pi [--dry-run]
       vigil uninstall-hooks --agent pi [--dry-run]
       vigil install-shell [--settings FILE] [--dry-run]
       vigil uninstall-shell [--settings FILE] [--dry-run]
       vigil check-shell [--host COOKED-HOST]
       vigil coverage on|off|status [--settings FILE] [--dry-run]
       vigil snapshots on|off|status [--settings FILE] [--dry-run]
       vigil snapshots forget [DIR]
       vigil snapshot [--now [DIR]]
       vigil version

Keeps what Claude Code's hooks report, or pi's extension, under $VIGIL_DATA_DIR
(by default ~/.local/share/vigil), for emacs/vigil.el to show.  Nothing leaves
this machine.
EOF
}

# The session this agent is in, or nothing: a name that could not be a file's
# is no name.
_vigil_session() {
  local name="${VIGIL_SESSION:-${COOKED_HOST_SESSION:-}}"
  if [[ "$name" =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]]; then
    printf '%s' "$name"
  fi
}

vigil_hook() {
  local session hosted=1 event dir name
  session=$(_vigil_session)
  [ -n "$session" ] || hosted=0
  [ -t 0 ] && return 0
  if [ "$hosted" = 0 ] && ! _vigil_archive_wanted 0; then
    cat >/dev/null
    return 0
  fi
  mkdir -p "$VIGIL_DATA_DIR" 2>/dev/null || { cat >/dev/null; return 0; }
  event=$(mktemp "$VIGIL_DATA_DIR/.event.XXXXXX") || { cat >/dev/null; return 0; }
  # JSON has no raw line breaks inside strings, so removing them is lossless.
  tr -d '\r\n' > "$event"
  _vigil_archive_wanted "$hosted" && _vigil_archive "$session" "$event"
  if [ "$hosted" = 1 ]; then
    dir="$VIGIL_RECORDS_DIR/$session"
    _vigil_session_start "$dir" "$event"
    # Time first, so that the names sort by age: microseconds where bash has
    # them, seconds otherwise; the pid and a random number keep two events in
    # the same instant apart.  A reporter that starts its hooks alongside each
    # other says when each event happened (VIGIL_EVENT_TIME), which is not
    # the order they get here in.
    name="${EPOCHREALTIME:-$(date +%s)}"
    # Some locales write the fraction after a comma.
    name="${name/,/.}"
    if [[ "${VIGIL_EVENT_TIME:-}" =~ ^[0-9]{9,11}(\.[0-9]{1,6})?$ ]]; then
      name="$VIGIL_EVENT_TIME"
    fi
    name="$name-$$-$RANDOM.json"
    if mkdir -p "$dir" 2>/dev/null \
        && _vigil_fit "$event" "$VIGIL_RECORD_MAX" > "$dir/.$$.tmp" \
        && printf '\n' >> "$dir/.$$.tmp" \
        && mv -f "$dir/.$$.tmp" "$dir/$name"; then
      _vigil_shell_mark "$dir"
      _vigil_prompt_history "$session" "$dir/$name"
      _vigil_prune "$dir"
    else
      rm -f "$dir/.$$.tmp"
    fi
  fi
  rm -f "$event"
}

# Whether this agent runs its commands through bin/vigil-shell, said by a file
# in the session's records ($1/.shell) that is there from when it began to and
# gone when it no longer does.  A hook is told the prefix in its environment;
# Emacs is not, and needs to know which commands it should have been able to
# follow, to say so when it could not.
_vigil_shell_mark() {
  local mark="$1/.shell" prefix="${CLAUDE_CODE_SHELL_PREFIX:-}"
  if [ "${prefix##*/}" = vigil-shell ]; then
    [ -e "$mark" ] || : > "$mark"
  elif [ -e "$mark" ]; then
    rm -f "$mark"
  fi
  return 0
}

# When an agent starts in the session whose records are in $1 -- a new
# conversation, not one resumed, cleared or compacted -- what an earlier agent
# left under the same name is not this one's, and goes.  All but the last few
# seconds of it: hooks run alongside each other, and this agent's first prompt
# may have been recorded already.  Sessions nothing has reported from for
# VIGIL_KEEP_DAYS go at the same time, so that nothing else has to know when a
# session ended.
_vigil_session_start() {
  local dir="$1" event="$2" head now file stamp
  head=$(head -c 4096 "$event")
  [[ "$head" =~ \"hook_event_name\"[[:space:]]*:[[:space:]]*\"SessionStart\" ]] || return 0
  find "$VIGIL_RECORDS_DIR" -mindepth 1 -maxdepth 1 -type d \
       -mtime +"$VIGIL_KEEP_DAYS" -exec rm -rf {} + 2>/dev/null || true
  [[ "$head" =~ \"source\"[[:space:]]*:[[:space:]]*\"startup\" ]] || return 0
  [ -d "$dir" ] || return 0
  now=$(date +%s)
  for file in "$dir"/*.json; do
    [ -e "$file" ] || continue
    stamp="${file##*/}"
    stamp="${stamp%%[.-]*}"
    [[ "$stamp" =~ ^[0-9]+$ ]] || continue
    if (( stamp < now - 5 )); then rm -f "$file"; fi
  done
  return 0
}

# The event in file $1 on stdout, no larger than $2 bytes, still JSON.  Over
# the limit, its largest values -- a command's output, a file's contents --
# are replaced by {"vigil_truncated": true, "bytes": N, "head": "..."}.
_vigil_fit() {
  local file="$1" max="$2"
  if [ "$(wc -c < "$file")" -le "$max" ]; then
    cat "$file"
    return
  fi
  python3 - "$file" "$max" << 'PYEOF'
import json, sys
path, limit = sys.argv[1], int(sys.argv[2])
raw = open(path, encoding="utf-8", errors="replace").read()
def marker(value):
    text = value if isinstance(value, str) else json.dumps(value)
    return {"vigil_truncated": True, "bytes": len(text.encode()),
            "head": text[:max(0, limit // 4)]}
try:
    event = json.loads(raw)
except ValueError:
    event = None
if not isinstance(event, dict):
    out = json.dumps({"vigil_unreadable": True, "bytes": len(raw.encode()),
                      "head": raw[:max(0, limit // 4)]})
else:
    for key in ("tool_response", "tool_input", "last_assistant_message", "prompt"):
        if len(json.dumps(event).encode()) <= limit:
            break
        if key in event:
            event[key] = marker(event[key])
    out = json.dumps(event, ensure_ascii=False)
sys.stdout.write(out)
PYEOF
}

# Whether events are archived: VIGIL_ARCHIVE=0 turns the archive off; an agent
# outside a hosted session ($1 = 0) is archived only with VIGIL_ARCHIVE_ALL=1.
_vigil_archive_wanted() {
  [ "${VIGIL_ARCHIVE:-1}" != 0 ] || return 1
  [ "$1" = 1 ] || [ "${VIGIL_ARCHIVE_ALL:-0}" = 1 ]
}

# The archive: $VIGIL_ARCHIVE_DIR/<YYYY>/<MM>/<session_id>.jsonl, one line per
# event in the order they came -- {"t": <epoch>, "host": <session or null>,
# "hosted": <bool>, "event": <the event, verbatim>} -- appended under a short
# lock so that two hooks at once (they are async) cannot interleave.  Never
# pruned.  A session's file stays in the month it began.  Its first event also
# adds a line to $VIGIL_ARCHIVE_DIR/index.jsonl.
_vigil_archive() {
  local session="$1" event="$2" id file line new=0
  id=$(head -c 4096 "$event" | grep -o -m 1 '"session_id"[[:space:]]*:[[:space:]]*"[A-Za-z0-9_-]*"' \
         | head -n 1 | sed 's/.*"\([A-Za-z0-9_-]*\)"$/\1/')
  [ -n "$id" ] || id=unknown
  mkdir -p "$VIGIL_ARCHIVE_DIR" 2>/dev/null || return 0
  _vigil_lock "$VIGIL_ARCHIVE_DIR/.lock" || return 0
  file=$(find "$VIGIL_ARCHIVE_DIR" -mindepth 3 -maxdepth 3 -name "$id.jsonl" -print -quit 2>/dev/null)
  if [ -z "$file" ]; then
    file="$VIGIL_ARCHIVE_DIR/$(date +%Y/%m)/$id.jsonl"
    mkdir -p "$(dirname "$file")" && new=1
  fi
  line="$VIGIL_ARCHIVE_DIR/.line.$$"
  # Whole or not at all: an event that could not be fitted is not half a line.
  { printf '{"t":%s,"host":%s,"hosted":%s,"event":' "$(date +%s)" \
      "$( [ -n "$session" ] && printf '"%s"' "$session" || printf null)" \
      "$( [ -n "$session" ] && printf true || printf false)" \
      && _vigil_fit "$event" "$VIGIL_ARCHIVE_RECORD_MAX" \
      && printf '}\n'; } > "$line" && cat "$line" >> "$file"
  rm -f "$line"
  [ "$new" = 1 ] && _vigil_archive_index "$id" "$session" "$event" "$file"
  _vigil_unlock "$VIGIL_ARCHIVE_DIR/.lock"
  return 0
}

# One line for a new session in $VIGIL_ARCHIVE_DIR/index.jsonl: when, which
# session, which directory and model (as far as its first event says), and the
# git branch and commit of that directory -- read from the repository as it is
# on disk; nothing is fetched.
_vigil_archive_index() {
  local id="$1" session="$2" event="$3" file="$4"
  python3 - "$id" "$session" "$event" "$file" "$VIGIL_ARCHIVE_DIR" << 'PYEOF' >> "$VIGIL_ARCHIVE_DIR/index.jsonl"
import json, os, subprocess, sys, time
sid, host, path, file, root = sys.argv[1:6]
try:
    event = json.load(open(path, encoding="utf-8", errors="replace"))
except ValueError:
    event = {}
if not isinstance(event, dict):
    event = {}
cwd = event.get("cwd") if isinstance(event.get("cwd"), str) else None
def git(*args):
    if not cwd or not os.path.isdir(cwd):
        return None
    try:
        # Whatever git this was started under, the repository is cwd's.
        env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
        out = subprocess.run(["git", "-C", cwd, *args], capture_output=True,
                             text=True, timeout=2, env=env)
        return (out.stdout.strip() or None) if out.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        return None
model = event.get("model")
print(json.dumps({"session_id": sid, "started": int(time.time()),
                  "host": host or None, "hosted": bool(host),
                  "file": os.path.relpath(file, root), "cwd": cwd,
                  "git_branch": git("rev-parse", "--abbrev-ref", "HEAD"),
                  "git_commit": git("rev-parse", "HEAD"),
                  "model": model if isinstance(model, (str, dict)) else None,
                  "first_event": event.get("hook_event_name")}))
PYEOF
}

# Take the lock directory $1, waiting up to $2 seconds (10, unsaid) for whoever
# holds it.  The holder says inside it who it is.  A lock whose holder is gone,
# or that is a minute old -- nothing here takes that long -- was left by one
# that was killed, and is taken over.  Fails, having taken nothing, when the
# wait is over, or when the lock cannot be made at all.
_vigil_lock() {
  local lock="$1" deadline=$((SECONDS + ${2:-10})) holder
  until mkdir "$lock" 2>/dev/null; do
    # Not to be made at all: somewhere that is not there, or cannot be
    # written.  (Not there now may only mean that it was just let go.)
    [ -w "${lock%/*}" ] || return 1
    holder=$(cat "$lock/pid" 2>/dev/null)
    if { [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; } \
        || [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
      rm -f "$lock/pid"
      rmdir "$lock" 2>/dev/null
      continue
    fi
    [ "$SECONDS" -lt "$deadline" ] || return 1
    sleep 0.01
  done
  echo "$$" > "$lock/pid"
}

# Let go of the lock directory $1.
_vigil_unlock() {
  rm -f "$1/pid"
  rmdir "$1" 2>/dev/null
}

# Whether --dry-run is among the arguments.
_vigil_dry_run_p() {
  local arg
  for arg in "$@"; do [ "$arg" = --dry-run ] && return 0; done
  return 1
}

# The directory this program is in, wherever a link to it was followed from.
_vigil_here() {
  python3 -c 'import os, sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' \
    "${BASH_SOURCE[0]}"
}

# Forget whatever git this was started under: the repository is the one the
# directory asked about is in.
_vigil_git_alone() {
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR \
        GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_PREFIX
}

# A prompt, kept in a history of the prompts given to agents on this machine:
# $VIGIL_PROMPT_HISTORY, one JSON object per line -- {"host", "time", "event"},
# the event as the hook was handed it -- appended, so that it outlives the
# session's records and their cap.  Only the newest VIGIL_PROMPT_HISTORY_MAX
# are kept.
_vigil_prompt_history() {
  local session="$1" record="$2" lines
  grep -q '"hook_event_name"[[:space:]]*:[[:space:]]*"UserPromptSubmit"' "$record" || return 0
  mkdir -p "$(dirname "$VIGIL_PROMPT_HISTORY")" 2>/dev/null || return 0
  # One at a time: a prompt added while the oldest are being dropped is lost.
  _vigil_lock "$VIGIL_PROMPT_HISTORY.lock" || return 0
  printf '{"host":"%s","time":%s,"event":%s}\n' "$session" "$(date +%s)" "$(cat "$record")" \
    >> "$VIGIL_PROMPT_HISTORY"
  lines=$(wc -l < "$VIGIL_PROMPT_HISTORY")
  if (( lines > VIGIL_PROMPT_HISTORY_MAX + VIGIL_PROMPT_HISTORY_MAX / 10 )); then
    tail -n "$VIGIL_PROMPT_HISTORY_MAX" "$VIGIL_PROMPT_HISTORY" > "$VIGIL_PROMPT_HISTORY.$$" \
      && mv -f "$VIGIL_PROMPT_HISTORY.$$" "$VIGIL_PROMPT_HISTORY"
  fi
  _vigil_unlock "$VIGIL_PROMPT_HISTORY.lock"
}

_vigil_prune() {
  local dir="$1" files n
  files=("$dir"/*.json)
  n=${#files[@]}
  (( n > VIGIL_RECORDS_MAX )) || return 0
  # The names begin with the time they were written, so the glob's order is age.
  rm -f "${files[@]:0:n-VIGIL_RECORDS_MAX}"
}

# install-hooks / uninstall-hooks [--settings FILE] [--dry-run]
#
# Merges vigil's hook into Claude Code's settings, or takes it out, and leaves
# every other hook alone: vigil's are the entries whose command contains "vigil
# hook", and only those are added or removed, so running either twice changes
# nothing the second time.  --dry-run prints the change as a diff and writes
# nothing.  The file is first copied to a backup of its own
# (<file>.vigil-backup-<time>), which never replaces an existing file.  A
# settings file that is not valid JSON is refused rather than overwritten.
#
# The hook is put on PreToolUse, PostToolUse, SubagentStart, SubagentStop,
# UserPromptSubmit, SessionStart and Stop, async: it never makes the agent wait.
#
# install-shell / uninstall-shell are the same care taken over two settings:
# "env": {"CLAUDE_CODE_SHELL_PREFIX": <bin/vigil-shell>}, which has Claude Code
# run every shell command through vigil-shell; and the directory cooked keeps
# runs in, added to "sandbox": {"filesystem": {"allowWrite": [...]}}, so that
# a command run in Claude Code's sandbox can still be kept.  That entry lets a
# sandboxed command write in that one directory, where only what commands
# printed is kept, and nowhere else; it means nothing while the sandbox is
# off.  A prefix that is somebody else's is left alone, and said to be.
vigil_hooks() {
  local mode="$1"; shift
  local settings="$VIGIL_SETTINGS" dry_run=0 here prefix agent=claude
  here=$(_vigil_here) || return 1
  prefix="$here/vigil-shell"
  # Where `cooked-host run' keeps runs: the same rule as src/run.rs in cooked.
  local runs="${COOKED_RUN_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/cooked/runs}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --settings|--agent)
        [ $# -ge 2 ] || { echo "vigil: $1 needs a value" >&2; return 1; }
        if [ "$1" = --settings ]; then settings="$2"; else agent="$2"; fi
        shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      *) echo "vigil: unknown option: $1" >&2; return 1 ;;
    esac
  done
  case "$agent" in
    claude) ;;
    pi)
      case "$mode" in
        install|uninstall) vigil_pi "$mode" "$dry_run" "$here" ;;
        *-shell)
          echo "vigil: pi's commands cannot be followed as they run yet." >&2
          return 1 ;;
        *)
          # Coverage and snapshots are settings of Claude Code's; pi's
          # extension looks for the files that say they are on.
          echo "vigil: --agent pi goes with install-hooks and uninstall-hooks only." >&2
          return 1 ;;
      esac
      return ;;
    *) echo "vigil: unknown agent: $agent (claude or pi)" >&2; return 1 ;;
  esac
  if [[ "$mode" == uninstall* ]] && [ ! -f "$settings" ]; then
    echo "No settings file found at ${settings}"
    return 0
  fi
  if [ "$mode" = install-shell ] && [ "$dry_run" = 0 ]; then
    mkdir -p "$runs" 2>/dev/null && chmod 700 "$runs" 2>/dev/null
  fi
  python3 - "$settings" "$mode" "$dry_run" "$prefix" "$runs" \
    "$VIGIL_COVERAGE_DIR" << 'PYEOF'
import difflib, json, os, sys, time

path, mode, dry_run, prefix = sys.argv[1], sys.argv[2], sys.argv[3] == "1", sys.argv[4]
runs, coverage = sys.argv[5], sys.argv[6]
# A settings file that is a link stays one: what it points to is what changes.
path = os.path.realpath(path)

# The hook that keeps reports never makes the agent wait.  The one that keeps
# snapshots does, for the moment it takes: what the files were when a prompt
# was given has to be kept before the agent changes them.
if mode.endswith("-snapshots"):
    marker = "vigil snapshot"
    entry = {"hooks": [{"type": "command", "command": "vigil snapshot", "timeout": 10}]}
    # And around each command the agent runs, failed or not: what the command
    # changed is the files after it against the files before it.
    matchers = {"UserPromptSubmit": None, "Stop": None,
                "PreToolUse": "Bash", "PostToolUse": "Bash", "PostToolUseFailure": "Bash"}
else:
    marker = "vigil hook"
    entry = {"hooks": [{"type": "command", "command": "vigil hook", "async": True}]}
    # A call that fails is reported as an event of its own, not as one that ended.
    matchers = dict.fromkeys(("PreToolUse", "PostToolUse", "PostToolUseFailure",
                              "SubagentStart", "SubagentStop",
                              "UserPromptSubmit", "SessionStart", "Stop"))

def ours(hook):
    # The command itself, by whatever path: not one that only has its words.
    words = hook.get("command", "").split() if isinstance(hook, dict) else []
    return len(words) == 2 and [os.path.basename(words[0]), words[1]] == marker.split()

before = ""
settings = {}
if os.path.isfile(path):
    with open(path, encoding="utf-8") as f:
        before = f.read()
    try:
        settings = json.loads(before) if before.strip() else {}
    except json.JSONDecodeError as e:
        sys.exit(f"{path} is not valid JSON ({e}); not touching it.")
    if not isinstance(settings, dict):
        sys.exit(f"{path} does not hold a JSON object; not touching it.")
original = json.loads(json.dumps(settings))

def change_hooks():
    hooks = settings.get("hooks", {})
    if not isinstance(hooks, dict):
        sys.exit(f"{path}: \"hooks\" is not an object; not touching it.")
    # Only vigil's command goes: an entry it shares with another keeps the other.
    for event in list(hooks):
        if isinstance(hooks[event], list):
            kept = []
            for e in hooks[event]:
                if isinstance(e, dict) and isinstance(e.get("hooks"), list):
                    rest = [h for h in e["hooks"] if not ours(h)]
                    if not rest:
                        continue
                    if len(rest) != len(e["hooks"]):
                        e = dict(e, hooks=rest)
                kept.append(e)
            hooks[event] = kept
    if mode.startswith("install"):
        for event, matcher in matchers.items():
            new = json.loads(json.dumps(entry))
            # Every call of the event, or only those of the tool it is for.
            hooks.setdefault(event, []).append({"matcher": matcher, **new} if matcher else new)
    for event in list(hooks):
        if hooks[event] == []:
            del hooks[event]
    if hooks:
        settings["hooks"] = hooks
    else:
        settings.pop("hooks", None)

def change_shell():
    env = settings.get("env", {})
    if not isinstance(env, dict):
        sys.exit(f"{path}: \"env\" is not an object; not touching it.")
    key = "CLAUDE_CODE_SHELL_PREFIX"
    now = env.get(key)
    if now is not None and os.path.basename(str(now)) != "vigil-shell":
        sys.exit(f"{path} already sets {key} to {now}, which is not vigil's; "
                 "not touching it.")
    if mode == "install-shell":
        if not os.access(prefix, os.X_OK):
            sys.exit(f"{prefix} is not there to be run; not touching {path}.")
        env[key] = prefix
    else:
        env.pop(key, None)
    if env:
        settings["env"] = env
    else:
        settings.pop("env", None)
    # The one directory a sandboxed command has to be able to write in.
    allow(runs, mode == "install-shell")

def change_coverage():
    # Where a sandboxed command's programs write which functions they ran.
    allow(coverage, mode == "install-coverage")

def allow(directory, add):
    sandbox = settings.get("sandbox", {})
    if not isinstance(sandbox, dict):
        sys.exit(f"{path}: \"sandbox\" is not an object; not touching it.")
    filesystem = sandbox.get("filesystem", {})
    if not isinstance(filesystem, dict):
        sys.exit(f"{path}: \"sandbox.filesystem\" is not an object; not touching it.")
    allowed = filesystem.get("allowWrite", [])
    if not isinstance(allowed, list):
        sys.exit(f"{path}: \"sandbox.filesystem.allowWrite\" is not a list; not touching it.")
    allowed = [a for a in allowed if a != directory]
    if add:
        allowed.append(directory)
    if allowed:
        filesystem["allowWrite"] = allowed
    else:
        filesystem.pop("allowWrite", None)
    if filesystem:
        sandbox["filesystem"] = filesystem
    else:
        sandbox.pop("filesystem", None)
    if sandbox:
        settings["sandbox"] = sandbox
    else:
        settings.pop("sandbox", None)

if mode.endswith("-shell"):
    what = "the shell prefix"
    change_shell()
elif mode.endswith("-coverage"):
    what = "the sandbox's leave to write " + coverage
    change_coverage()
elif mode.endswith("-snapshots"):
    what = "the hook that keeps snapshots"
    change_hooks()
else:
    what = "vigil's hook"
    change_hooks()

if settings == original:
    print(f"Nothing to change in {path}.")
    sys.exit(0)

after = json.dumps(settings, indent=2, ensure_ascii=False) + "\n"
if dry_run:
    sys.stdout.writelines(difflib.unified_diff(
        before.splitlines(True), after.splitlines(True), path, path + " (after)"))
    sys.exit(0)

if before:
    # A backup never replaces anything: a name of its own, made exclusively.
    stamp = time.strftime("%Y%m%dT%H%M%S")
    for n in range(100):
        backup = f"{path}.vigil-backup-{stamp}" + (f"-{n}" if n else "")
        try:
            with open(backup, "x", encoding="utf-8") as f:
                f.write(before)
            break
        except FileExistsError:
            continue
    else:
        sys.exit(f"No free name to back {path} up to; not touching it.")
    print(f"Backed up {path} → {backup}")
os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
tmp = path + ".vigil-tmp"
try:
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(after)
    os.replace(tmp, path)
finally:
    # Left only by a write that failed.
    if os.path.exists(tmp):
        os.unlink(tmp)
print(f"{'Installed' if mode.startswith('install') else 'Removed'} {what} in {path}.")
PYEOF
}

# install-hooks --agent pi / uninstall-hooks --agent pi [--dry-run]
#
# pi has no hooks in a settings file: it loads the extensions in a directory
# of its own, and pi/vigil.ts is one that hands `vigil hook' what pi reports.
# Installing copies it there as vigil.ts; uninstalling removes it.  Only a
# file that is vigil's is ever replaced or removed -- it says so in its first
# line -- and one that is somebody else's is left alone, and said to be.
# A pi that is already running keeps the extensions it started with.
vigil_pi() {
  local mode="$1" dry_run="$2" here="$3" source dir target
  source="$here/../pi/vigil.ts"
  dir="${VIGIL_PI_EXTENSIONS:-${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/extensions}"
  target="$dir/vigil.ts"
  if [ -e "$target" ] && ! head -n 1 "$target" | grep -q 'handed to `vigil hook'; then
    echo "$target is not vigil's; not touching it." >&2
    return 1
  fi
  if [ "$mode" = uninstall ]; then
    if [ ! -e "$target" ]; then
      echo "Nothing to change: no $target."
    elif [ "$dry_run" = 1 ]; then
      echo "Would remove $target."
    else
      rm -f "$target" && echo "Removed vigil's extension, $target."
    fi
    return
  fi
  if [ ! -r "$source" ]; then
    echo "vigil: $source is not there to be installed." >&2
    return 1
  fi
  if [ -e "$target" ] && cmp -s "$source" "$target"; then
    echo "Nothing to change in $target."
  elif [ "$dry_run" = 1 ]; then
    if [ -e "$target" ]; then
      diff -u "$target" "$source" || :
    else
      echo "Would copy $source to $target."
    fi
  else
    mkdir -p "$dir" && cp "$source" "$dir/.vigil.ts.$$" \
      && mv -f "$dir/.vigil.ts.$$" "$target" \
      && echo "Installed vigil's extension in $target."
  fi
}

# check-shell [--host COOKED-HOST]
#
# bin/vigil-shell tells the commands of Claude Code's Bash tool from everything
# else it is handed by their shape, which Claude Code does not promise to keep.
# This asks the Claude Code that is installed to run one command through it,
# for real, and says whether the command was known for one and kept -- the
# thing to run after Claude Code has been updated.  It starts `claude' once,
# on its smallest model, in a directory of its own that is removed afterwards;
# nothing of the check is recorded or archived.
vigil_check_shell() {
  local host="${COOKED_HOST:-}" here dir out word="vigil-check-$$" status=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --host)
        [ $# -ge 2 ] || { echo "vigil: $1 needs a value" >&2; return 1; }
        host="$2"; shift 2 ;;
      *) echo "vigil: unknown option: $1" >&2; return 1 ;;
    esac
  done
  [ -n "$host" ] || host=$(command -v cooked-host 2>/dev/null)
  if [ -z "$host" ] || [ ! -x "$host" ]; then
    echo "vigil: cannot find cooked's host program; name it with --host, or set COOKED_HOST." >&2
    return 1
  fi
  command -v claude >/dev/null 2>&1 || { echo "vigil: \`claude' is not on the PATH." >&2; return 1; }
  here=$(_vigil_here) || return 1
  dir=$(mktemp -d) || return 1
  mkdir -p "$dir/work" "$dir/runs"
  echo "Asking $(claude --version 2>/dev/null | head -n 1) to run one command through vigil-shell..."
  # As a session manager starts one: not as the child of an agent this may
  # itself have been started from.
  out=$(cd "$dir/work" && env -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT -u CLAUDE_CODE_SESSION_ID \
          -u CLAUDE_CODE_CHILD_SESSION -u CLAUDE_PID \
          COOKED_HOST="$host" COOKED_HOST_SESSION=vigil-check COOKED_RUN_DIR="$dir/runs" \
          VIGIL_DATA_DIR="$dir/data" VIGIL_ARCHIVE=0 \
          CLAUDE_CODE_SHELL_PREFIX="$here/vigil-shell" \
          claude -p "Use the Bash tool to run exactly this one command, then reply with only its output: echo $word" \
                 --model haiku --allowedTools Bash < /dev/null 2>&1)
  if grep -qs "\"label\":\"echo $word\"" "$dir"/runs/vigil-check/*.json \
      && grep -qsx "$word" "$dir"/runs/vigil-check/*.out; then
    echo "ok: its commands are known to vigil-shell, and kept as they print."
    status=0
  elif ! printf '%s' "$out" | grep -q "$word"; then
    echo "Could not tell: Claude Code did not run the command.  It said:"
    printf '%s\n' "$out" | tail -n 5
    status=2
  else
    echo "NOT followed: the command ran, but vigil-shell did not know it for one of the"
    echo "Bash tool's.  Claude Code has probably changed how it hands them over; the"
    echo "pattern at the top of $here/vigil-shell needs to be the new one."
    echo "Commands still run as they always did; they are only not kept as they print."
  fi
  rm -rf "$dir"
  return "$status"
}

# coverage on|off|status [--settings FILE] [--dry-run]
#
# Whether the Python and Node programs an agent's commands run note which
# functions of the project they ran (coverage/, bin/vigil-shell).  Off unless
# turned on: it puts a directory of vigil's on those programs' PYTHONPATH and
# an option in their NODE_OPTIONS.  On is a file, $VIGIL_DATA_DIR/coverage-on,
# which vigil-shell looks for; and, in Claude Code's settings, the one
# directory it is all written to added to the sandbox's allowWrite, as
# install-shell adds the one runs are kept in.  Needs install-shell: it is
# vigil-shell that tells the programs.
vigil_coverage() {
  local what="${1:-status}"
  [ $# -gt 0 ] && shift
  local switch="$VIGIL_DATA_DIR/coverage-on"
  local dir="$VIGIL_COVERAGE_DIR" dry_run=0
  _vigil_dry_run_p "$@" && dry_run=1
  case "$what" in
    on)
      vigil_hooks install-coverage "$@" || return 1
      if [ "$dry_run" = 0 ]; then
        mkdir -p "$dir" "$VIGIL_DATA_DIR" && chmod 700 "$dir" && : > "$switch" || return 1
        echo "Coverage is on: kept under $dir, from the next command an agent runs."
      fi ;;
    off)
      vigil_hooks uninstall-coverage "$@" || return 1
      if [ "$dry_run" = 0 ]; then
        rm -f "$switch"
        echo "Coverage is off.  What was kept is still under $dir."
      fi ;;
    status)
      if [ -e "$switch" ]; then echo "Coverage is on."; else echo "Coverage is off."; fi
      if [ -d "$dir" ]; then
        echo "Kept under $dir: $(du -sh "$dir" 2>/dev/null | cut -f1)"
      fi ;;
    *) echo "vigil: coverage on, off or status" >&2; return 1 ;;
  esac
}

# --- snapshots ---------------------------------------------------------------------
#
# What a repository's files were at a moment, kept in the repository's own
# .git as a commit nothing else points to: the files git tracks as they are in
# the working tree, and those it neither tracks nor ignores, up to
# VIGIL_SNAPSHOT_MAX bytes each.  Two of them are a diff: what changed after a
# prompt is the one kept when it was given against the one kept when the agent
# stopped (emacs/vigil-snapshot.el).
#
# Nothing of the repository's is touched: not its index, its HEAD, its
# branches, its stash or its files.  A snapshot is made with an index of
# vigil's own (<git dir>/vigil-index), which also remembers what it has read,
# so that the next one reads only what changed.  It is whole or it is not
# there: the commit is written first, and one ref is then moved to it, which
# git does atomically.  The ref is $VIGIL_SNAPSHOT_REF, one per working tree,
# never pushed or fetched; the snapshots before the newest are held by its
# reflog, as stashes are by theirs, and git's own collection drops them when
# they are a month old (gc.reflogExpireUnreachable).  A repository says it
# wants none with `git config vigil.snapshots false'.
#
# Each says, in its message, why it was taken and for whom:
#   vigil <event> <session id> <prompt id> <hosted session's name> <agent>
# with - for what is not known.  The agent is the program that was given the
# prompt: claude, or what a reporter says of itself in "agent" (pi/vigil.ts
# says pi).
#
# One is also taken before and after each command the agent runs, and those
# two are what the command changed.  Most commands change nothing, so one of
# these is kept only where the files differ from the last snapshot kept, and
# its message has two more words:
#   ... <agent> <the call's id> <the snapshot before it>
# So one kept after a call (PostToolUse, PostToolUseFailure) is what the call
# changed, against the snapshot it names; and one kept before a call
# (PreToolUse) is what changed since the last snapshot with no call of the
# agent's running: you, another agent, a command left in the background.  A
# call with none after it changed nothing.  Two commands run at once cannot be
# told apart: what both changed is the one's that ended last, or shared.

_vigil_word() {
  # $1 where it could be one word of a message, and - where it could not.
  if [[ "${1:-}" =~ ^[A-Za-z0-9._:-]+$ ]]; then printf '%s' "$1"; else printf -- '-'; fi
}

# vigil_snapshot_take DIR [EVENT [SESSION [PROMPT [HOST [AGENT [CALL]]]]]]
#
# Keep a snapshot of the repository DIR is in and print its commit.  Fails,
# having changed nothing, where there is no repository with a working tree,
# where it wants none, where there is no perl to list its files with, or where
# another snapshot of it is still being taken after some seconds.
#
# With CALL, the id of a call of the agent's, it is one taken before or after
# that call: kept, and its commit printed, only where the files differ from
# the last snapshot kept, which its message then names.
vigil_snapshot_take() {
  local dir="${1:-.}" message call="${7:-}"
  message="vigil $(_vigil_word "${2:-}") $(_vigil_word "${3:-}") $(_vigil_word "${4:-}") $(_vigil_word "${5:-}") $(_vigil_word "${6:-}")"
  command -v perl >/dev/null 2>&1 || return 1
  (
    _vigil_git_alone
    _vigil_git_direct
    export GIT_OPTIONAL_LOCKS=0
    export GIT_AUTHOR_NAME=vigil GIT_AUTHOR_EMAIL=vigil@localhost
    export GIT_COMMITTER_NAME=vigil GIT_COMMITTER_EMAIL=vigil@localhost
    cd "$dir" 2>/dev/null || exit 1
    root= gitdir=
    { IFS= read -r root; IFS= read -r gitdir; } \
      < <(git rev-parse --show-toplevel --absolute-git-dir 2>/dev/null)
    [ -n "$root" ] && [ -d "$gitdir" ] || exit 1
    [ "$(git config --type=bool vigil.snapshots 2>/dev/null)" = false ] && exit 1
    cd "$root" || exit 1
    index="$gitdir/vigil-index" lock="$gitdir/vigil-snapshot.lock"
    # Around a call, mostly nothing has changed: that is told at once.
    if [ -n "$call" ] && _vigil_snapshot_unchanged "$index"; then exit 0; fi
    # One at a time, and not for longer than whoever asked will wait.
    _vigil_lock "$lock" 4 || exit 1
    trap '_vigil_unlock "$lock"' EXIT
    export GIT_INDEX_FILE="$index" VIGIL_SNAPSHOT_MAX
    tree=
    for attempt in 1 2; do
      # Holding the lock, an index lock here is one a killed snapshot left.
      rm -f "$index.lock"
      if [ ! -s "$index" ] && [ -s "$gitdir/index" ]; then
        # Begin from the repository's index: what it knows to be unchanged
        # need not be read again.  Only ever read, and only this once.
        cp "$gitdir/index" "$index" 2>/dev/null
      fi
      if _vigil_snapshot_index >/dev/null 2>&1 \
          && tree=$(_vigil_snapshot_git write-tree 2>/dev/null) && [ -n "$tree" ]; then
        break
      fi
      # An index that cannot be used is begun again, once.
      tree=
      rm -f "$index" "$index.lock"
    done
    [ -n "$tree" ] || exit 1
    if [ -n "$call" ]; then
      before=$(git rev-parse -q --verify "$VIGIL_SNAPSHOT_REF^{commit}" 2>/dev/null) || before=
      if [ -n "$before" ]; then
        [ "$(git rev-parse -q --verify "$before^{tree}" 2>/dev/null)" = "$tree" ] && exit 0
      fi
      message="$message $(_vigil_word "$call") $(_vigil_word "$before")"
    fi
    # Asked for one to look at, with the files as the last kept has them:
    # that one is it, and no other is made.
    if [ "${2:-}" = View ]; then
      before=$(git rev-parse -q --verify "$VIGIL_SNAPSHOT_REF^{commit}" 2>/dev/null) || before=
      if [ -n "$before" ] \
          && [ "$(git rev-parse -q --verify "$before^{tree}" 2>/dev/null)" = "$tree" ]; then
        printf '%s\n' "$before"
        exit 0
      fi
    fi
    commit=$(git commit-tree --no-gpg-sign -m "$message" "$tree" 2>/dev/null) || exit 1
    git update-ref --create-reflog -m "$message" "$VIGIL_SNAPSHOT_REF" "$commit" \
        >/dev/null 2>&1 || exit 1
    printf '%s\n' "$commit"
  )
}

# On macOS /usr/bin/git is not git but a program that finds git and runs it,
# which takes longer than most of what is asked of git here, a dozen times a
# snapshot.  Where that is the git there is, the one it would find is put
# first on the path: the same git, started once.
_vigil_git_direct() {
  local tools=/Library/Developer/CommandLineTools/usr/bin
  if [ "$(command -v git)" = /usr/bin/git ] && [ -x "$tools/git" ]; then
    PATH="$tools:$PATH"
  fi
}

# Whether the files are as the last snapshot kept them, by INDEX, vigil's
# index, which that snapshot was written from: nothing it has is changed or
# gone, and nothing is there that it has not, but for what no snapshot keeps
# (a file over VIGIL_SNAPSHOT_MAX, a repository inside this one).  What only
# the repository's index was told -- such a file added to it, and so kept
# from now on -- is no change of a file, and waits for the next one taken.
#
# git is started once for this, where a snapshot starts it a dozen times.
# Fails where it cannot tell, or where there are more files too big than are
# worth looking at: a snapshot is then taken, which says the same more slowly.
_vigil_snapshot_unchanged() {
  local index="$1" line big=()
  [ -s "$index" ] || return 1
  while IFS= read -r -d '' line; do
    case "$line" in
      "? "*/) ;;
      "? "*) big+=("${line#? }"); [ "${#big[@]}" -le 8 ] || return 1 ;;
      *) return 1 ;;
    esac
  done < <(GIT_INDEX_FILE="$index" git ls-files -z -t --modified --deleted --others \
             --exclude-standard 2>/dev/null || printf 'failed\0')
  [ "${#big[@]}" -eq 0 ] && return 0
  # Each of them a file, not a link, too big to be kept.
  [ "$(find "${big[@]}" -maxdepth 0 -type f -size +"${VIGIL_SNAPSHOT_MAX}c" 2>/dev/null \
       | wc -l | tr -d ' ')" -eq "${#big[@]}" ]
}

# git, for what writes vigil's index.  Never as a split index: one would share
# a file with the repository's own, and git, writing vigil's, would drop the
# shared files it takes to be old -- the repository's among them.
_vigil_snapshot_git() {
  git -c core.splitIndex=false -c splitIndex.sharedIndexExpire=never "$@"
}

# Make vigil's index say what a snapshot is of, as the files are now: the
# files the repository's own index tracks, and those git neither tracks nor
# ignores -- regular files up to VIGIL_SNAPSHOT_MAX bytes, and links; not
# directories, which is how a repository inside this one is listed.  Worked
# out anew each time, so that a file since ignored, taken out of git or grown
# too big is no longer kept, and one since committed is.  The repository's
# index is only read.
_vigil_snapshot_index() {
  perl - << 'PERLEOF'
use strict;
use warnings;
$/ = "\0";
my $max = $ENV{VIGIL_SNAPSHOT_MAX};
my $mine = $ENV{GIT_INDEX_FILE};
my @git = ("git", "-c", "core.splitIndex=false", "-c", "splitIndex.sharedIndexExpire=never");

# The paths a listing names: of vigil's index, or else of the repository's.
sub listed {
  my ($own, @args) = @_;
  local $ENV{GIT_INDEX_FILE} = $mine;
  delete $ENV{GIT_INDEX_FILE} unless $own;
  open(my $out, "-|", @git, "ls-files", "-z", @args) or exit 1;
  my @paths = <$out>;
  close($out) or exit 1;
  chomp @paths;
  return @paths;
}

# Have vigil's index take the paths, as update-index does with the options.
sub told {
  my ($options, @paths) = @_;
  return unless @paths;
  open(my $in, "|-", @git, "update-index", @$options, "-z", "--stdin") or exit 1;
  print $in "$_\0" for @paths;
  close($in) or exit 1;
}

my %keep;
for (listed(0)) {
  # A directory where a file was tracked holds files of its own now, listed
  # below; unless it is a repository, which is tracked as one.
  next if -d $_ and not -l $_ and not -e "$_/.git";
  $keep{$_} = 1;
}
for (listed(0, "--others", "--exclude-standard")) {
  my @is = lstat($_) or next;
  $keep{$_} = 1 if -l _ or (-f _ and $is[7] <= $max);
}
told(["--force-remove"], grep { !$keep{$_} } listed(1));
# A file gone from the working tree goes; one where a directory was, or under
# where a file was, takes its place.
told(["--add", "--remove", "--replace"], sort keys %keep);
PERLEOF
}

# snapshot           the hook: an event on standard input.  Keeps a snapshot of
#                    the repository the agent is working in, saying which
#                    event, session and prompt it was for.  Prints nothing --
#                    what a prompt's hook prints is given to the agent -- and
#                    never fails.
# snapshot --now [DIR]   keep one of DIR's repository now, and print its commit.
vigil_snapshot() {
  if [ "${1:-}" = --now ]; then
    vigil_snapshot_take "${2:-.}" View
    return
  fi
  [ -t 0 ] && return 0
  if [ "${VIGIL_SNAPSHOTS:-1}" = 0 ]; then cat >/dev/null; return 0; fi
  local fields event session prompt cwd agent who call
  if command -v jq >/dev/null 2>&1; then
    fields=$(jq -r '[.hook_event_name, .session_id, .prompt_id, .cwd, .agent_id, .agent, .tool_use_id]
                    | map(if type == "string" then . else "" end) | join("\u001f")' 2>/dev/null) || :
  else
    fields=$(python3 -c '
import json, sys
event = json.load(sys.stdin)
print("\x1f".join(v if isinstance(v, str) else "" for v in (
    event.get(k) for k in ("hook_event_name", "session_id", "prompt_id", "cwd", "agent_id", "agent",
                           "tool_use_id"))))
' 2>/dev/null) || :
  fi
  IFS=$'\x1f' read -r event session prompt cwd agent who call <<< "$fields" || :
  [ -n "$event" ] || return 0
  case "$event" in
    PreToolUse|PostToolUse|PostToolUseFailure)
      # Around a call, a subagent's as much as the agent's own.
      [ -n "$call" ] && [ "${VIGIL_SNAPSHOT_CALLS:-1}" != 0 ] || return 0 ;;
    *)
      # A subagent's prompt is not one given to this repository's agent.
      [ -z "$agent" ] || return 0
      call= ;;
  esac
  # Claude Code does not say who it is; a reporter for another agent does.
  vigil_snapshot_take "${cwd:-$PWD}" "$event" "$session" "$prompt" "$(_vigil_session)" \
    "${who:-claude}" "$call" >/dev/null 2>&1 || :
  return 0
}

# snapshots on|off|status [--settings FILE] [--dry-run]
# snapshots forget [DIR]
#
# On puts `vigil snapshot' in Claude Code's settings as a hook on a prompt
# being given, on the agent stopping, and before and after each Bash command
# -- one that is waited for, unlike `vigil hook' -- and off takes it out; with
# the same care as install-hooks.
# On is also a file, $VIGIL_DATA_DIR/snapshots-on, which pi's extension looks
# for (pi/vigil.ts): pi has no settings to put a hook in.
# Forget removes every snapshot kept of DIR's repository, and vigil's index.
vigil_snapshots() {
  local what="${1:-status}" dry_run=0 switch="$VIGIL_DATA_DIR/snapshots-on"
  [ $# -gt 0 ] && shift
  _vigil_dry_run_p "$@" && dry_run=1
  case "$what" in
    on)
      vigil_hooks install-snapshots "$@" || return 1
      [ "$dry_run" = 1 ] && return 0
      mkdir -p "$VIGIL_DATA_DIR" && : > "$switch" || return 1
      echo "A snapshot is kept in a repository's .git from the next prompt given in it." ;;
    off)
      vigil_hooks uninstall-snapshots "$@" || return 1
      [ "$dry_run" = 1 ] && return 0
      rm -f "$switch"
      echo "What was kept stays in each repository until \`vigil snapshots forget' there." ;;
    status)
      if [ -e "$switch" ] || grep -qs '"vigil snapshot"' "$VIGIL_SETTINGS"; then
        echo "Snapshots are on."
      else
        echo "Snapshots are off."
      fi
      local n
      n=$( (_vigil_git_alone; git log -g --format=%H "$VIGIL_SNAPSHOT_REF" -- 2>/dev/null) \
           | wc -l | tr -d ' ')
      [ "${n:-0}" -gt 0 ] && echo "Kept of this repository: $n."
      return 0 ;;
    forget)
      (
        _vigil_git_alone
        cd "${1:-.}" 2>/dev/null || { echo "vigil: no such directory: ${1:-.}" >&2; exit 1; }
        gitdir=$(git rev-parse --absolute-git-dir 2>/dev/null) \
          || { echo "vigil: not in a repository." >&2; exit 1; }
        git update-ref -d "$VIGIL_SNAPSHOT_REF" 2>/dev/null
        rm -f "$gitdir/vigil-index" "$gitdir/vigil-index.lock"
        _vigil_unlock "$gitdir/vigil-snapshot.lock"
        echo "Forgot the snapshots of $(git rev-parse --show-toplevel 2>/dev/null)."
      ) ;;
    *) echo "vigil: snapshots on, off, status or forget" >&2; return 1 ;;
  esac
}

# --- setting it all up, and saying what is set up -----------------------------------

# doctor [--settings FILE]
#
# Say what of vigil is in place on this machine, and for each thing that is
# not, the command that puts it there.  Only reads.
vigil_doctor() {
  local settings="$VIGIL_SETTINGS" here program found missing line state what fix
  while [ $# -gt 0 ]; do
    case "$1" in
      --settings)
        [ $# -ge 2 ] || { echo "vigil: $1 needs a value" >&2; return 1; }
        settings="$2"; shift 2 ;;
      *) echo "vigil: unknown option: $1" >&2; return 1 ;;
    esac
  done
  here=$(_vigil_here) || return 1
  _vigil_said() { printf '  %-8s %-46s %s\n' "$1" "$2" "${3:-}"; }
  # Of the programs named, those on the path into $found, the others into $missing.
  _vigil_look_for() {
    found= missing=
    for program in "$@"; do
      if command -v "$program" >/dev/null 2>&1; then found="$found $program"; else missing="$missing $program"; fi
    done
    found="${found# }" missing="${missing# }"
  }

  echo "vigil $VIGIL_VERSION, from $here"
  echo
  echo "Programs"
  _vigil_look_for bash python3 git perl jq
  [ -n "$found" ] && _vigil_said ok "$found"
  for program in $missing; do
    case "$program" in
      perl) _vigil_said missing perl "no snapshot is kept without it" ;;
      jq) _vigil_said missing jq "optional: python3 reads the reports instead, more slowly" ;;
      *) _vigil_said missing "$program" "needed" ;;
    esac
  done
  if [ -n "${COOKED_HOST:-}" ] || command -v cooked-host >/dev/null 2>&1; then
    _vigil_said ok cooked-host
  else
    _vigil_said missing cooked-host "optional: commands are not followed as they run without it"
  fi
  _vigil_look_for shfmt ruff prettier
  [ -n "$found" ] && _vigil_said ok "$found"
  [ -n "$missing" ] && _vigil_said missing "$missing" "optional: commands are shown as given without them"

  echo
  echo "Claude Code  ($settings)"
  if [ ! -f "$settings" ]; then
    _vigil_said off "no settings file" "vigil setup"
  else
    while IFS=$'\t' read -r state what fix; do
      _vigil_said "$state" "$what" "$fix"
    done < <(python3 - "$settings" "$here/vigil-shell" << 'PYEOF'
import json, os, sys

try:
    with open(sys.argv[1], encoding="utf-8") as f:
        settings = json.load(f)
    assert isinstance(settings, dict)
except Exception:
    print("broken\tthe file is not a JSON object\tmend it, then: vigil setup")
    sys.exit(0)
hooks = settings.get("hooks") if isinstance(settings.get("hooks"), dict) else {}

def on(event, words, matcher=None):
    for entry in hooks.get(event) or []:
        if not isinstance(entry, dict) or entry.get("matcher") != matcher:
            continue
        for hook in entry.get("hooks") or []:
            said = hook.get("command", "").split() if isinstance(hook, dict) else []
            if len(said) == 2 and [os.path.basename(said[0]), said[1]] == words:
                return True
    return False

def say(have, what, fix, again=None):
    n = sum(have)
    state = "on" if n == len(have) else "partly" if n else "off"
    print(f"{state}\t{what}\t{'' if state == 'on' else again if n and again else fix}")

record = ("PreToolUse", "PostToolUse", "PostToolUseFailure", "SubagentStart",
          "SubagentStop", "UserPromptSubmit", "SessionStart", "Stop")
say([on(e, ["vigil", "hook"]) for e in record],
    "records: every prompt, call and reply", "vigil install-hooks",
    "vigil install-hooks  (it has more to listen for now)")
say([on(e, ["vigil", "snapshot"]) for e in ("UserPromptSubmit", "Stop")],
    "snapshots when a prompt is given, and after", "vigil snapshots on")
say([on(e, ["vigil", "snapshot"], "Bash")
     for e in ("PreToolUse", "PostToolUse", "PostToolUseFailure")],
    "snapshots around each command", "vigil snapshots on")
env = settings.get("env") if isinstance(settings.get("env"), dict) else {}
prefix = env.get("CLAUDE_CODE_SHELL_PREFIX")
if prefix is None:
    print("off\tcommands followed as they run\tvigil install-shell")
elif os.path.basename(str(prefix)) != "vigil-shell":
    print(f"other\tcommands followed as they run\tthe prefix is somebody else's: {prefix}")
elif not os.access(str(prefix), os.X_OK):
    print(f"broken\tcommands followed as they run\t{prefix} is not there: vigil install-shell")
else:
    print("on\tcommands followed as they run\t")
PYEOF
    )
    if [ -e "$VIGIL_DATA_DIR/coverage-on" ]; then
      _vigil_said on "which code a command ran"
    else
      _vigil_said off "which code a command ran" "optional: vigil coverage on"
    fi
  fi

  echo
  local pi_dir="${VIGIL_PI_EXTENSIONS:-${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/extensions}"
  echo "pi  ($pi_dir)"
  if [ ! -d "${pi_dir%/extensions}" ] && ! command -v pi >/dev/null 2>&1; then
    _vigil_said none "pi is not on this machine"
  elif [ ! -e "$pi_dir/vigil.ts" ]; then
    _vigil_said off "vigil's extension" "vigil install-hooks --agent pi"
  elif cmp -s "$here/../pi/vigil.ts" "$pi_dir/vigil.ts"; then
    _vigil_said on "vigil's extension"
    if [ -e "$VIGIL_DATA_DIR/snapshots-on" ]; then
      _vigil_said on "snapshots, around its commands too"
    else
      _vigil_said off "snapshots" "vigil snapshots on"
    fi
  else
    _vigil_said old "vigil's extension is not this vigil's" "vigil install-hooks --agent pi"
  fi

  echo
  echo "Kept  ($VIGIL_DATA_DIR)"
  if [ -d "$VIGIL_DATA_DIR" ]; then
    _vigil_said "$(du -sh "$VIGIL_DATA_DIR" 2>/dev/null | cut -f1 | tr -d ' ')" \
      "records, prompts and the archive"
  else
    _vigil_said none "nothing yet"
  fi
  local root n
  root=$( (_vigil_git_alone; git rev-parse --show-toplevel 2>/dev/null) )
  if [ -n "$root" ]; then
    n=$( (_vigil_git_alone; git log -g --format=%H "$VIGIL_SNAPSHOT_REF" -- 2>/dev/null) | wc -l | tr -d ' ')
    if [ "$( (_vigil_git_alone; git config --type=bool vigil.snapshots 2>/dev/null) )" = false ]; then
      _vigil_said off "snapshots of $root" "it wants none: git config --unset vigil.snapshots"
    else
      _vigil_said "$n" "snapshots of $root"
    fi
  fi

  echo
  echo "Emacs  (not looked at from here)"
  echo "  (require 'vigil) (vigil-setup), with cooked and $(dirname "$here")/emacs on the load-path"
  echo
  echo "An agent that is already running keeps the hooks it started with: restart it."
  unset -f _vigil_said _vigil_look_for
}

# setup [--shell] [--settings FILE] [--dry-run]
#
# Everything an agent needs to be watched, at once: the hook that keeps
# reports, the one that keeps snapshots, and pi's extension where pi is on
# this machine.  With --shell, also the prefix that follows commands as they
# run, which changes how every command of Claude Code's is started.  Each as
# its own command does it, with the same care; then what is in place is said.
vigil_setup() {
  # dry is --dry-run or nothing: a word to the commands below, or none.
  local shell=0 settings="$VIGIL_SETTINGS" dry=
  while [ $# -gt 0 ]; do
    case "$1" in
      --shell) shell=1; shift ;;
      --dry-run) dry=$1; shift ;;
      --settings)
        [ $# -ge 2 ] || { echo "vigil: $1 needs a value" >&2; return 1; }
        settings="$2"; shift 2 ;;
      *) echo "vigil: unknown option: $1" >&2; return 1 ;;
    esac
  done
  vigil_hooks install --settings "$settings" $dry || return 1
  vigil_snapshots on --settings "$settings" $dry || return 1
  if [ "$shell" = 1 ]; then
    vigil_hooks install-shell --settings "$settings" $dry || return 1
  fi
  if [ -d "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}" ] || command -v pi >/dev/null 2>&1; then
    vigil_hooks install --agent pi $dry || return 1
  fi
  [ -n "$dry" ] && return 0
  echo
  vigil_doctor --settings "$settings"
}

# Sourced by the tests for its functions.
if [ "${VIGIL_TESTING:-}" = 1 ] && [ "${BASH_SOURCE[0]}" != "$0" ]; then
  return 0
fi

case "${1:-}" in
  hook)            vigil_hook; exit 0 ;;
  install-hooks)   shift; vigil_hooks install "$@" ;;
  uninstall-hooks) shift; vigil_hooks uninstall "$@" ;;
  install-shell)   shift; vigil_hooks install-shell "$@" ;;
  uninstall-shell) shift; vigil_hooks uninstall-shell "$@" ;;
  check-shell)     shift; vigil_check_shell "$@" ;;
  coverage)        shift; vigil_coverage "$@" ;;
  snapshot)
    # The hook never fails; asked for one now, it says whether it could.
    shift; vigil_snapshot "$@"; status=$?
    if [ "${1:-}" = --now ]; then exit "$status"; fi
    exit 0 ;;
  snapshots)       shift; vigil_snapshots "$@" ;;
  setup)           shift; vigil_setup "$@" ;;
  doctor)          shift; vigil_doctor "$@" ;;
  version|--version) echo "vigil $VIGIL_VERSION" ;;
  -h|--help|help)  vigil_usage ;;
  *)               vigil_usage >&2; exit 1 ;;
esac
