#!/bin/bash
# vigil-shell — Claude Code's shell commands, run where Emacs can follow them.
#
# For CLAUDE_CODE_SHELL_PREFIX, which Claude Code puts in front of everything
# it hands a shell: the commands of its Bash tool, and also its hooks, its
# status line and the servers it starts.  Each arrives whole, as one argument.
#
# A command of the Bash tool, from an agent in one of cooked's hosted
# sessions, is run through `cooked-host run', which runs it exactly as it
# would have been run and keeps what it prints, as it comes, for a buffer to
# follow.  Everything else -- a hook, an agent in no hosted session, a
# machine without cooked -- is run as if this were not here.
#
# Asked to (`vigil coverage on'), it also tells the Python and Node programs
# such a command runs to note which functions of the project they ran.
#
# This must never be the reason a command fails, so whatever it cannot do it
# does not attempt, and it prints nothing of its own.

shell="${CLAUDE_CODE_SHELL:-${SHELL:-/bin/bash}}"

# The Bash tool's commands are told by their shape: the agent's own command is
# handed to `eval', with its standard input closed, and the directory it ends
# in is noted after it.  A command with a heredoc keeps its standard input, so
# it comes without the `< /dev/null'.  Nothing else Claude Code runs has either.
case "${1:-}" in
  *"&& eval '"*"' < /dev/null && pwd -P >| "*) after="' < /dev/null && pwd -P >| " ;;
  *"&& eval '"*"' && pwd -P >| "*) after="' && pwd -P >| " ;;
  *) exec "$shell" -c "${1:-}" ;;
esac

# What the agent asked for, as it wrote it: what `eval' was given, unquoted.
# The name the run goes by, and how it is matched to the report of the call.
command="${1#*"&& eval '"}"
command="${command%"$after"*}"
# An apostrophe in it was written the way Claude Code writes one inside single
# quotes ('"'"'), or the other way ('\'').
quote="'" doubled="'\"'\"'" escaped="'\\''"
command="${command//"$doubled"/$quote}"
command="${command//"$escaped"/$quote}"

# Which functions of the project the command's Python and Node programs ran,
# where that has been asked for: `vigil coverage on', or VIGIL_COVERAGE=1.
# Only said to them, in their environment: each is told to load a few lines
# of vigil's as it starts (coverage/), and where to write.  No file is made
# here, and none at all by a command that runs no such program.  A command
# of any agent, hosted or not: this has nothing to do with cooked.
data="${VIGIL_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/vigil}"
coverage=0
case "${VIGIL_COVERAGE:-}" in
  0) ;;
  1) coverage=1 ;;
  *) [ -e "$data/coverage-on" ] && coverage=1 ;;
esac
if [ "$coverage" = 1 ] && now=$(date +%s 2>/dev/null) && [ -n "$now" ]; then
  # Beside this program, as it was named: `vigil install-shell' names it by
  # its true place.
  hooks="${BASH_SOURCE[0]%/*}/../coverage"
  session="${VIGIL_SESSION:-${COOKED_HOST_SESSION:-${CLAUDE_CODE_SESSION_ID:-none}}}"
  session="${session//[^A-Za-z0-9._-]/_}"
  export VIGIL_COVERAGE_RUN="${VIGIL_COVERAGE_DIR:-$data/coverage}/$session/$now-$$"
  # Enough of the command to tell it by: the whole of a long one, twice over
  # with its argument, could be more than a program may be handed.
  export VIGIL_COVERAGE_COMMAND="${command:0:4096}"
  export VIGIL_COVERAGE_CWD="$PWD"
  if [ -f "$hooks/python/sitecustomize.py" ]; then
    export PYTHONPATH="$hooks/python${PYTHONPATH:+:$PYTHONPATH}"
  fi
  # A name with a space or a quote in it could not be said to Node this way.
  case "$hooks" in
    *[[:space:]\"\'\\]*) ;;
    *) if [ -f "$hooks/node/vigil-coverage.cjs" ]; then
         export NODE_OPTIONS="--require $hooks/node/vigil-coverage.cjs${NODE_OPTIONS:+ $NODE_OPTIONS}"
       fi ;;
  esac
fi

host="${COOKED_HOST:-cooked-host}"
if [ -z "${COOKED_HOST_SESSION:-}" ] || ! command -v "$host" >/dev/null 2>&1; then
  exec "$shell" -c "$1"
fi

exec "$host" run --label "$command" --key "${CLAUDE_CODE_SESSION_ID:-}" -- "$shell" -c "$1"
